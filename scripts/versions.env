# Pinned versions of cwipc's dependencies, read by the scripts in this directory
# (cwi-dis/cwipc#355). Format: KEY=value lines, no spaces, no quotes, so that both
# bash ("source versions.env") and PowerShell (parse the lines) can read it.
# Comments start with #.

# Python (cwi-dis/cwipc#355, decision of 2026-11-13):
# - PYTHON_VERSION: the preferred minor version. What gets installed when there is no
#   suitable Python (brew python@3.12, the Windows installer) and what CI builds and
#   tests with. Also the newest version accepted.
# - PYTHON_VERSION_MIN: the oldest minor version accepted if it is already there:
#   PYTHON_VERSION or the one before it, no older. Only partly tested (the Debian
#   package uses the system Python).
# - PYTHON_WINDOWS_INSTALLER_VERSION: the full version of the Windows installer.
# CMakeLists.txt reads PYTHON_VERSION and PYTHON_VERSION_MIN from here too.
PYTHON_VERSION=3.12
PYTHON_VERSION_MIN=3.12
PYTHON_WINDOWS_INSTALLER_VERSION=3.12.10

# OrbbecSDK: the release, and the name of its archive per platform (the names
# carry a per-platform build stamp). From https://github.com/orbbec/OrbbecSDK_v2/releases
ORBBECSDK_VERSION=2.6.3
ORBBECSDK_ARCHIVE_MACOS=OrbbecSDK_v2.6.3_202512232227_4e448f9_macOS
ORBBECSDK_ARCHIVE_LINUX=OrbbecSDK_v2.6.3_202512231427_4e448f9_linux_x86_64
ORBBECSDK_ARCHIVE_WINDOWS=OrbbecSDK_v2.6.3_202512232226_4e448f9_win_x64
